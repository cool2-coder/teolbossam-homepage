# Postgres 접속 주소 (Supabase: Project Settings > Database > Connection string)
DATABASE_URL=postgres://teol:teol@localhost:5432/teol

# 홈페이지 주소 (문자 속 링크에 들어갑니다)
SITE_URL=https://teolbo.kr

# 관리자(털보쌤) 비밀번호
ADMIN_PASSWORD=change-me

# 솔라피 문자 발송 (비워 두면 실제로 보내지 않고 '문자 기록'에만 남깁니다)
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
# 솔라피에 등록한 발신번호 (숫자만)
SMS_FROM=

# 학부모 답장이 오면 털보쌤에게 알림 문자 보낼 번호 (선택)
TEACHER_PHONE=

# Vercel 크론이 재알림 주소를 호출할 때 쓰는 비밀값
CRON_SECRET=change-me-too
